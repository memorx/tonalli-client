# ══════════════════════════════════════════════
# Bureau Tonalli — Client Portal
# Copy this file to .env.local and fill in values
# ══════════════════════════════════════════════

# Database (same Supabase instance as internal portal)
DATABASE_URL=postgresql://postgres.xxx:password@aws-0-eu-west-3.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.xxx:password@aws-0-eu-west-3.pooler.supabase.com:5432/postgres

# Auth
NEXTAUTH_SECRET=your-secret-here
NEXTAUTH_URL=http://localhost:3001
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Dev mode (set to true to enable dev login without Google OAuth)
ENABLE_DEV_LOGIN=true

# Email (Resend)
# Without RESEND_API_KEY, sendEmail() degrades to a no-op (logs + returns false)
RESEND_API_KEY=
EMAIL_FROM=Bureau Tonalli <notifications@bureautonalli.com>

# Supabase Realtime (browser-side, public)
# Without these, useClientRealtime() degrades silently — no live events,
# the UI still works via server-side renders + manual refresh.
# From Supabase Dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Frame.io (review platform integration)
# - FRAME_IO_TOKEN: Personal Token from https://developer.frame.io/ → My Account
#   Used by the adapter (read-only assets + comments). Without it, getAsset()
#   returns null with a warn log; no crash.
# - FRAME_IO_WEBHOOK_SECRET: Signing secret from Frame.io Webhook config
#   (Developer Portal → Webhooks → your webhook). Used by the webhook handler
#   to verify HMAC-SHA256 signatures. Without it, webhook returns 503.
FRAME_IO_TOKEN=
FRAME_IO_WEBHOOK_SECRET=
